{
    "model": "EfficientNet-B0",
    "num_classes": 3,
    "classes": [
        "Meningioma",
        "Glioma",
        "Pituitary"
    ],
    "input": {
        "source": "grayscale MRI",
        "channels": 3,
        "conversion": "grayscale_to_rgb",
        "size": [
            224,
            224
        ]
    },
    "normalization": {
        "mean": [
            0.485,
            0.456,
            0.406
        ],
        "std": [
            0.229,
            0.224,
            0.225
        ]
    },
    "mri_intensity_normalization": {
        "percentile_low": 1,
        "percentile_high": 99,
        "range": [
            0,
            255
        ]
    },
    "xai": {
        "method": "Grad-CAM",
        "target_layer": "model.features[-1]"
    }
}